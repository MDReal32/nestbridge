{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "basic-server",
  "root": "examples/basic/server",
  "sourceRoot": "examples/basic/server/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "examples/basic/server"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/main.js",
        "cwd": "examples/basic/server"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "examples/basic/server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "examples/basic/server"
      }
    }
  }
}
