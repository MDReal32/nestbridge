{
  "name": "nestbridge",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDReal32/nestbridge.git",
    "directory": "packages/nestbridge"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./vite": {
      "types": "./build/vite.d.ts",
      "import": "./build/vite.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
