  },
  "dependencies": {
    "@nestbridge/runtime": "workspace:*",
    "@nestbridge/vite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "rolldown-plugin-dts": "^0.28.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
