{
  "name": "@nestbridge/vite",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./build/nestbridge.vite.js",
  "types": "./build/nestbridge.vite.d.ts",
  "exports": {
    ".": {
      "types": "./build/nestbridge.vite.d.ts",
      "import": "./build/nestbridge.vite.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "nx": {
    "name": "vite",
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  },
  "dependencies": {
    "@nestbridge/core": "workspace:*",
    "@nestbridge/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vite": "^6.0.7"
  }
}
