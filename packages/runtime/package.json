{
  "name": "@nestbridge/runtime",
  "version": "2.5.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDReal32/nestbridge.git",
    "directory": "packages/runtime"
  },
  "main": "./build/nestbridge.runtime.js",
  "types": "./build/nestbridge.runtime.d.ts",
  "exports": {
    ".": {
      "types": "./build/nestbridge.runtime.d.ts",
      "import": "./build/nestbridge.runtime.js"
    },
    "./microservices": {
      "types": "./build/nestbridge.runtime.microservices.d.ts",
      "import": "./build/nestbridge.runtime.microservices.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@types/node": "^26.4.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/microservices": "^12.0.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/microservices": {
      "optional": true
    }
