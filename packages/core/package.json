{
  "name": "@nestbridge/core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./build/nestbridge.core.js",
  "types": "./build/nestbridge.core.d.ts",
  "exports": {
    ".": {
      "types": "./build/nestbridge.core.d.ts",
      "import": "./build/nestbridge.core.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check ."
  },
  "nx": {
    "name": "core",
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^5.0.0"
  }
}
