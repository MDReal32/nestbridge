{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "paths": {
      "@nestbridge/core": ["./packages/core/src/index.ts"],
      "@nestbridge/runtime": ["./packages/runtime/src/index.ts"],
      "@nestbridge/unplugin": ["./packages/unplugin/src/main.ts"],
      "@nestbridge/vite": ["./packages/vite/src/main.ts"],
      "@nestbridge/webpack": ["./packages/webpack/src/main.ts"],
      "nestbridge": ["./packages/nestbridge/src/index.ts"],
      "nestbridge/vite": ["./packages/nestbridge/src/vite.ts"],
      "nestbridge/webpack": ["./packages/nestbridge/src/webpack.ts"]
    }
  }
}
